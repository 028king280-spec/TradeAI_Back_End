# ============================================================
# AIVOLVE TRADING AI — ENVIRONMENT CONFIGURATION
# ============================================================

# Upstox API v2 Credentials
UPSTOX_ACCESS_TOKEN=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/auth/upstox/callback
UPSTOX_ANALYTICS_TOKEN=

# Market Data Provider ("upstox" | "dhan" | "mock")
MARKET_DATA_PROVIDER=upstox

# Database (PostgreSQL with asyncpg; falls back to SQLite if not configured)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aivolve_trading

# Redis Cache (falls back to in-memory cache if Redis is offline)
REDIS_URL=redis://localhost:6379/0

# AI & LLM Explanation Layer (Arcee AI Trinity / OpenAI compatible)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=trinity-large-thinking

# Application Settings
APP_ENV=development
APP_NAME="AIVOLVE Trading AI"
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://trade.aivolvetech.in"

# Indian Market Hours (IST)
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30

# Scoring & Qualification Thresholds
QUALIFICATION_SCORE_THRESHOLD=80
PUT_QUALIFICATION_SCORE_THRESHOLD=75
WATCH_SCORE_THRESHOLD=60
LOG_LEVEL=INFO
